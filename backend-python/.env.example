# ─── Qdrant Vector Database (local Docker) ────────────────────────────────────
QDRANT_URL=http://localhost:6333
COLLECTION_NAME=researchflow

# ─── Groq Cloud LLM (fast, free) ──────────────────────────────────────────────
# Get your free key from: https://console.groq.com
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile

# LLM provider selection: set to 'groq', 'gemini', or 'deepseek'.
# If using 'gemini', configure GEMINI_API_KEY below and set LLM_PROVIDER=gemini
# If using 'deepseek', configure DEEPSEEK_API_KEY below and set LLM_PROVIDER=deepseek
LLM_PROVIDER=groq

# ─── Gemini (Google) — optional fallback / alternative to Groq
# Do NOT commit your real key. Use secrets management in production.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-mini
GEMINI_ENDPOINT=https://generative.googleapis.com/v1beta2/models

# ─── Local Embedding (FastEmbed ONNX — 768-dim BAAI/bge-base-en-v1.5 default) ─────────
EMBED_MODEL=BAAI/bge-base-en-v1.5
EMBED_DIM=768
EMBED_BATCH_SIZE=16

# ─── Reranker (FastEmbed ONNX — local CPU) ────────────────────────────────────
RERANKER_MODEL=Xenova/ms-marco-MiniLM-L-12-v2

# ─── Hybrid Search & Concurrency Config ───────────────────────────────────────
HYBRID_CANDIDATE_COUNT=50
RERANKER_TOP_K=8
# Worker pool size for concurrent RAG & web operations (scale with expected concurrent users)
RAG_EXECUTOR_WORKERS=16

# ─── Web Search & Smart Orchestration ─────────────────────────────────────────
WEB_ALWAYS_ON=false
WEB_SUPPLEMENT_THRESHOLD=1.0

# ─── Document-Strict Guardrails ───────────────────────────────────────────────
# -2.0 = strict | -3.5 = standard default | -4.5 = loose
RELEVANCE_THRESHOLD=-3.5
# Minimum chunks that must pass before LLM is called
MIN_RELEVANT_CHUNKS=1

# ─── DeepSeek AI — optional alternative to Groq / Gemini ────────────────────
# Get your API key from: https://platform.deepseek.com/api_keys
# Do NOT commit your real key. Use secrets management in production.
DEEPSEEK_API_KEY=
# OpenAI-compatible base URL (default below works for all DeepSeek models)
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1

# ─── Service-to-Service Internal Authentication ───────────────────────────────
# Shared secret for internal API protection (sent in X-Internal-Key header).
# Generate a long random secret key in production (e.g. openssl rand -hex 32).
INTERNAL_API_KEY=generate_a_long_random_secret_key_here
