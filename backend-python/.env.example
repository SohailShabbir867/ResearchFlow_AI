# ─── Qdrant Vector Database (local Docker) ────────────────────────────────────
QDRANT_URL=http://localhost:6333
COLLECTION_NAME=medresearch

# ─── Groq Cloud LLM (fast, free) ──────────────────────────────────────────────
# Get your free key from: https://console.groq.com
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile

# LLM provider selection: set to 'groq' or 'gemini'.
# If using 'gemini', configure GEMINI_API_KEY below and set LLM_PROVIDER=gemini
LLM_PROVIDER=groq

# ─── Gemini (Google) — optional fallback / alternative to Groq
# Do NOT commit your real key. Use secrets management in production.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-mini
GEMINI_ENDPOINT=https://generative.googleapis.com/v1beta2/models

# ─── Local Embedding (FastEmbed ONNX — no VPS needed) ─────────────────────────
EMBED_MODEL=nomic-ai/nomic-embed-text-v1.5
EMBED_BATCH_SIZE=32

# ─── Reranker (FastEmbed ONNX — local CPU) ────────────────────────────────────
RERANKER_MODEL=Xenova/ms-marco-MiniLM-L-6-v2

# ─── Hybrid Search Config ─────────────────────────────────────────────────────
HYBRID_CANDIDATE_COUNT=20
RERANKER_TOP_K=5

# ─── Document-Strict Guardrails ───────────────────────────────────────────────
# -2.0 = strict (recommended) | -3.0 = moderate | -4.5 = loose (old default)
RELEVANCE_THRESHOLD=-2.0
# Minimum chunks that must pass before LLM is called
MIN_RELEVANT_CHUNKS=2

# ─── Service-to-Service Internal Authentication ───────────────────────────────
# Shared secret for internal API protection (sent in X-Internal-Key header).
# Generate a long random secret key in production (e.g. openssl rand -hex 32).
INTERNAL_API_KEY=generate_a_long_random_secret_key_here
