# ─── Qdrant Vector Database (local Docker) ────────────────────────────────────
QDRANT_URL=http://localhost:6333
COLLECTION_NAME=medresearch

# ─── Groq Cloud LLM (fast, free) ──────────────────────────────────────────────
# Get your free key from: https://console.groq.com
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile

# ─── Local Embedding (FastEmbed ONNX — no VPS needed) ─────────────────────────
EMBED_MODEL=nomic-ai/nomic-embed-text-v1.5
EMBED_BATCH_SIZE=32

# ─── Reranker (FastEmbed ONNX — local CPU) ────────────────────────────────────
RERANKER_MODEL=Xenova/ms-marco-MiniLM-L-6-v2

# ─── Hybrid Search Config ─────────────────────────────────────────────────────
HYBRID_CANDIDATE_COUNT=20
RERANKER_TOP_K=5
