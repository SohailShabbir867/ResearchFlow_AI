# ─── Node.js Backend Environment Variables ───────────────────────────────────
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.

# Server
PORT=5000
NODE_ENV=development

# MongoDB (local or Atlas URI)
MONGO_URI=mongodb://localhost:27017/medresearch

# JWT — CHANGE THIS to a long random string (min 32 chars) in production
# Generate one with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=change_this_to_a_long_random_string_minimum_32_chars

# Python RAG service URL (FastAPI / uvicorn)
PYTHON_RAG_URL=http://localhost:8000

# Frontend URL (for CORS)
FRONTEND_URL=http://localhost:5173
