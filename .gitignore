# OS files
.DS_Store
Thumbs.db

# Editor settings
.vscode/
.idea/
*.swp
*.swo

# ─── Environment files (NEVER commit these) ───────────────────────────────────
.env
.env.*
!.env.example
backend-python/.env
backend-node/.env

# Node.js
node_modules/
frontend/node_modules/
backend-node/node_modules/
frontend/dist/
frontend/.vite/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Python
__pycache__/
*.py[cod]
*.pyo
*.pyd
.python-version
.venv/
venv/
backend-python/.venv/
backend-python/venv/
.pytest_cache/
