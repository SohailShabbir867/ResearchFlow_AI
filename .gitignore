.ruff_cache/

# Python packaging / build output
build/
dist/
*.egg-info/

# FastEmbed model cache (large files, re-downloads automatically)
backend-python/.cache/
backend-python/models/

# Local data (documents and qdrant vector store are added locally, not tracked in git)
backend-python/data/documents/*
!backend-python/data/documents/.gitkeep
backend-python/data/**/*.pdf
backend-python/data/**/*.txt
backend-python/data/**/*.docx
backend-python/qdrant_storage/
backend-python/qdrant_storage/**
